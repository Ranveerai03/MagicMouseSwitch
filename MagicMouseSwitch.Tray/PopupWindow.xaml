<Window x:Class="MagicMouseSwitch.Tray.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410" Height="104"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" Topmost="True">
    <Border x:Name="Card"
            Margin="10" Padding="16,13,16,12"
            CornerRadius="17"
            MouseLeftButtonUp="Card_MouseLeftButtonUp">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="18" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.34" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconPlate" Width="42" Height="42" CornerRadius="12"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="31">
                        <Canvas Width="24" Height="34">
                            <Path x:Name="MouseOutline"
                                  Data="M12,1.5 C6.2,1.5 2.5,6.1 2.5,12 L2.5,22.5 C2.5,29 6.4,33 12,33 C17.6,33 21.5,29 21.5,22.5 L21.5,12 C21.5,6.1 17.8,1.5 12,1.5 Z M12,2 L12,12"
                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" />
                            <Ellipse x:Name="ScrollMark" Canvas.Left="10.6" Canvas.Top="6.2"
                                     Width="2.8" Height="5.2" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Ranveer’s Magic Mouse"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Margin="0,3,0,0"
                               FontSize="12.5" Text="Ready" />
                </StackPanel>

                <TextBlock x:Name="BatteryText" Grid.Column="2"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Visibility="Collapsed" />
            </Grid>

            <ProgressBar x:Name="DismissProgress" Grid.Row="1"
                         Margin="0,9,0,-7" Height="2"
                         BorderThickness="0" Minimum="0" Maximum="100" Value="100" />
        </Grid>
    </Border>
</Window>
